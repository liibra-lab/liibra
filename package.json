{
	"name": "liibra",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"gen:constituicao": "node --experimental-strip-types scripts/fetch-constituicao-planalto.ts",
		"test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test 'tests/**/*.test.ts'",
		"lint": "eslint .",
		"gate": "npm run check && npm run lint && npm test && npm run build",
		"test:e2e": "playwright test",
		"predeploy": "wrangler whoami",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.6.0",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"fast-xml-parser": "^5.9.2"
	}
}
