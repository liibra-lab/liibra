{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run gate)",
			"Bash(npm run check)",
			"Bash(npm run lint)",
			"Bash(npm run lint:*)",
			"Bash(npm test)",
			"Bash(npm test:*)",
			"Bash(npm run test:e2e)",
			"Bash(npm run test:e2e:*)",
			"Bash(npm run build)",
			"Bash(npm run gen)",
			"Bash(npm run dev)",
			"Bash(npm run dev:*)",
			"Bash(npm run preview)",
			"Bash(npm run preview:*)",
			"Bash(npm ci)",
			"Bash(npm ci:*)",
			"Bash(npx playwright test)",
			"Bash(npx playwright test:*)",
			"Bash(git status)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git blame:*)",
			"Bash(git fetch:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git checkout:*)",
			"Bash(git switch:*)",
			"Bash(git stash:*)",
			"Bash(git push -u origin claude/:*)",
			"Bash(git push origin claude/:*)",
			"Bash(git push --force-with-lease origin claude/:*)",
			"Edit",
			"Write",
			"WebFetch(domain:localhost)",
			"WebFetch(domain:127.0.0.1)",
			"WebFetch(domain:lexml.gov.br)",
			"WebFetch(domain:www.lexml.gov.br)",
			"WebFetch(domain:dadosabertos.camara.leg.br)",
			"WebFetch(domain:developers.cloudflare.com)",
			"WebFetch(domain:svelte.dev)",
			"WebFetch(domain:kit.svelte.dev)",
			"WebFetch(domain:tailwindcss.com)"
		],
		"ask": [
			"Bash(npm install:*)",
			"Bash(npm uninstall:*)",
			"Bash(npm update:*)",
			"Bash(npm audit fix:*)",
			"Bash(npm run gen:constituicao)",
			"Bash(npm run gen:sru-fixtures)",
			"Bash(git push origin main:*)",
			"mcp__github__merge_pull_request"
		],
		"deny": [
			"Bash(wrangler deploy)",
			"Bash(wrangler deploy:*)",
			"Bash(npx wrangler deploy)",
			"Bash(npx wrangler deploy:*)",
			"Bash(npm run deploy)",
			"Bash(npm run deploy:*)",
			"Bash(wrangler secret:*)",
			"Bash(npx wrangler secret:*)",
			"Bash(wrangler delete:*)",
			"Bash(npx wrangler delete:*)",
			"Bash(wrangler login:*)",
			"Bash(npx wrangler login:*)",
			"Bash(npm publish)",
			"Bash(npm publish:*)",
			"Read(.env)",
			"Read(.dev.vars)",
			"Read(.dev.vars.*)",
			"mcp__github__push_files",
			"mcp__github__create_or_update_file",
			"mcp__github__delete_file"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
